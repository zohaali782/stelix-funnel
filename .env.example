# Copy this file to .env for local testing. On Render, add these under Environment.

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Put the database name before the "?"
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/stelix?retryWrites=true&w=majority

# Any long secret you choose. Used to open /admin/leads?key=...
ADMIN_KEY=change-this-to-a-long-random-secret

# Optional instead of (or as well as) MongoDB: your Google Sheet web app URL (see google-sheet-script.js)
SHEET_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec
